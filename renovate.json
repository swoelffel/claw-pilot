{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "baseBranchPatterns": ["develop"],
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group AI SDK packages",
      "matchPackageNames": ["/^@ai-sdk\\//", "/^ai$/", "/^@openrouter\\/ai-sdk-provider$/"],
      "groupName": "ai-sdk"
    },
    {
      "description": "Group TypeScript tooling",
      "matchPackageNames": ["/^@typescript-eslint\\//", "/^typescript$/", "/^tsdown$/"],
      "groupName": "typescript-tooling"
    },
    {
      "description": "Group Vitest packages",
      "matchPackageNames": ["/^vitest$/", "/^@vitest\\//"],
      "groupName": "vitest"
    },
    {
      "description": "Group linters and formatters",
      "matchPackageNames": [
        "oxlint",
        "eslint",
        "prettier",
        "cspell",
        "knip",
        "madge",
        "eslint-plugin-sonarjs"
      ],
      "groupName": "lint-format"
    },
    {
      "description": "Major bumps require manual review and are separate unless explicitly coupled below",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-change"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Keep Vitest and its coverage provider on the same major version",
      "matchPackageNames": ["/^vitest$/", "/^@vitest\\//"],
      "matchUpdateTypes": ["major"],
      "groupName": "vitest"
    },
    {
      "description": "Upgrade Commitlint CLI and conventional config together",
      "matchPackageNames": ["@commitlint/cli", "@commitlint/config-conventional"],
      "matchUpdateTypes": ["major"],
      "groupName": "commitlint"
    },
    {
      "description": "Pin Node major to 22 (LTS) — skip v24 until conscious decision",
      "matchPackageNames": ["node"],
      "matchManagers": ["nvm", "npm", "github-actions", "dockerfile"],
      "allowedVersions": "<23.0.0"
    },
    {
      "description": "Keep Node.js types aligned with the Node 22 runtime",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23.0.0"
    },
    {
      "description": "The Node compatibility floor is a maintainer decision, not the reference runtime patch",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "pnpm — patches OK, minors require manual review",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "addLabels": ["needs-attention"]
    }
  ]
}
