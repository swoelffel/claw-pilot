{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "baseBranches": ["develop"],
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group AI SDK packages",
      "matchPackagePatterns": ["^@ai-sdk/", "^ai$", "^@openrouter/ai-sdk-provider$"],
      "groupName": "ai-sdk"
    },
    {
      "description": "Group TypeScript tooling",
      "matchPackagePatterns": ["^@typescript-eslint/", "^typescript$", "^tsdown$"],
      "groupName": "typescript-tooling"
    },
    {
      "description": "Group Vitest packages",
      "matchPackagePatterns": ["^vitest$", "^@vitest/"],
      "groupName": "vitest"
    },
    {
      "description": "Group linters and formatters",
      "matchPackageNames": [
        "oxlint",
        "eslint",
        "prettier",
        "cspell",
        "knip",
        "madge",
        "eslint-plugin-sonarjs"
      ],
      "groupName": "lint-format"
    },
    {
      "description": "Major bumps get their own PR — never grouped",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-change"],
      "automerge": false
    },
    {
      "description": "Security updates bypass the weekly schedule",
      "matchDatasources": ["npm"],
      "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security"],
        "schedule": ["at any time"]
      }
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
