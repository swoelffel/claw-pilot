{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "baseBranchPatterns": ["develop"],
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group AI SDK packages",
      "groupName": "ai-sdk",
      "matchPackageNames": [
        "/^@ai-sdk//",
        "/^ai$/",
        "/^@openrouter/ai-sdk-provider$/"
      ]
    },
    {
      "description": "Group TypeScript tooling",
      "groupName": "typescript-tooling",
      "matchPackageNames": [
        "/^@typescript-eslint//",
        "/^typescript$/",
        "/^tsdown$/"
      ]
    },
    {
      "description": "Group Vitest packages",
      "groupName": "vitest",
      "matchPackageNames": ["/^vitest$/", "/^@vitest//"]
    },
    {
      "description": "Group linters and formatters",
      "matchPackageNames": [
        "oxlint",
        "eslint",
        "prettier",
        "cspell",
        "knip",
        "madge",
        "eslint-plugin-sonarjs"
      ],
      "groupName": "lint-format"
    },
    {
      "description": "Major bumps get their own PR — never grouped",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-change"],
      "automerge": false
    },
    {
      "description": "Security updates bypass the weekly schedule",
      "matchDatasources": ["npm"],
      "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security"],
        "schedule": ["at any time"]
      }
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
