FROM debian:bookworm-slim

# System dependencies
RUN apt-get update && apt-get install -y \
    curl git sudo supervisor procps \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs

# pnpm — pinned to match packageManager field in package.json for reproducible builds
RUN npm install -g pnpm@10.33.0

# User clawpilot (uid 1000)
# Pre-create XDG_RUNTIME_DIR so the user can write to it without root
RUN useradd -m -u 1000 -s /bin/bash clawpilot \
    && mkdir -p /home/clawpilot/.claw-pilot /run/user/1000 \
    && chown clawpilot:clawpilot /home/clawpilot/.claw-pilot /run/user/1000

USER clawpilot
WORKDIR /app

# Install deps in a separate layer for Docker cache
# git init satisfies lefthook's git repo check during pnpm prepare hook
COPY --chown=clawpilot:clawpilot package.json pnpm-lock.yaml ./
RUN git init && pnpm install --frozen-lockfile

COPY --chown=clawpilot:clawpilot . .
RUN chmod +x /app/docker/entrypoint.sh && pnpm build:cli

EXPOSE 19000

ENTRYPOINT ["/app/docker/entrypoint.sh"]
