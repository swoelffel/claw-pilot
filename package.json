{
  "name": "claw-pilot",
  "version": "0.81.2",
  "description": "Orchestrator for claw-runtime multi-agent instances",
  "type": "module",
  "license": "MIT",
  "bin": {
    "claw-pilot": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && pnpm build:ui",
    "build:cli": "tsdown",
    "build:ui": "vite build ui/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "lint": "oxlint --deny-warnings src/",
    "lint:ui": "oxlint --deny-warnings ui/src/",
    "lint:all": "pnpm lint && pnpm lint:ui",
    "lint:complexity": "eslint src/",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:ui && pnpm typecheck:scripts",
    "lint:discipline:fast": "eslint --config eslint.discipline.config.js src/",
    "lint:discipline:full": "pnpm lint:discipline:fast && node --experimental-strip-types --no-warnings scripts/lint-orgid-slot.ts",
    "lint:discipline:ci": "pnpm lint:discipline:full && node --experimental-strip-types --no-warnings scripts/lint-core-modifications.ts",
    "format": "prettier --write \"src/**/*.ts\" \"ui/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"ui/src/**/*.ts\"",
    "build:safe": "pnpm typecheck:all && pnpm build",
    "knip": "knip",
    "check:circular": "madge --circular --extensions ts src/",
    "spellcheck": "cspell --config cspell.json \"src/**/*.ts\" \"ui/src/**/*.ts\"",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist/",
    "templates/",
    "install.sh"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "defu@<=6.1.4": ">=6.1.5",
      "brace-expansion@<5.0.5": ">=5.0.5"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.73",
    "@ai-sdk/google": "^3.0.66",
    "@ai-sdk/openai": "^3.0.55",
    "@hono/node-server": "^2.0.1",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.172",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dompurify": "^3.4.2",
    "fflate": "^0.8.2",
    "hono": "^4.12.16",
    "marked": "^18.0.2",
    "nanoid": "^5.1.11",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@lit/localize": "^0.12.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "cspell": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "knip": "^6.5.0",
    "lefthook": "^2.1.6",
    "lit": "^3.3.2",
    "madge": "^8.0.0",
    "oxlint": "^1.60.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.21.9",
    "typescript": "~6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  }
}
