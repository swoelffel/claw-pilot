{
  "name": "claw-pilot",
  "version": "0.70.0",
  "description": "Orchestrator for claw-runtime multi-agent instances",
  "type": "module",
  "license": "MIT",
  "bin": {
    "claw-pilot": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && pnpm build:ui",
    "build:cli": "tsdown",
    "build:ui": "vite build ui/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "lint": "oxlint --deny-warnings src/",
    "lint:ui": "oxlint --deny-warnings ui/src/",
    "lint:all": "pnpm lint && pnpm lint:ui",
    "lint:complexity": "eslint src/",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:ui",
    "format": "prettier --write \"src/**/*.ts\" \"ui/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"ui/src/**/*.ts\"",
    "build:safe": "pnpm typecheck:all && pnpm build",
    "knip": "knip",
    "check:circular": "madge --circular --extensions ts src/",
    "spellcheck": "cspell --config cspell.json \"src/**/*.ts\" \"ui/src/**/*.ts\"",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/",
    "templates/",
    "install.sh"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "defu@<=6.1.4": ">=6.1.5"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/google": "^3.0.60",
    "@ai-sdk/openai": "^3.0.52",
    "@inquirer/prompts": "^8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.5.0",
    "ai": "^6.0.153",
    "better-sqlite3": "^12",
    "chalk": "^5",
    "cli-table3": "^0.6",
    "commander": "^14",
    "dompurify": "^3.3.2",
    "hono": "^4.12.12",
    "marked": "^18.0.0",
    "nanoid": "^5",
    "ws": "^8",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@hono/node-server": "^1.19.13",
    "@lit/localize": "^0.12.2",
    "@types/better-sqlite3": "^7",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^25",
    "@types/ws": "^8",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.3",
    "cspell": "^10.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "knip": "^6.3.0",
    "lefthook": "^2.1.5",
    "lit": "^3",
    "madge": "^8.0.0",
    "oxlint": "^1.59.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.7",
    "typescript": "~6.0",
    "vite": "^8.0.5",
    "vitest": "^4"
  }
}
